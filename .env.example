# ==============================================================================
# 🏛️ SMART MUSEUM AI VOICE SERVER — ENVIRONMENT CONFIG TEMPLATE (.env.example)
# ==============================================================================

# 1. Groq LLM & Whisper STT (Bắt buộc cho AI RAG & Nhận diện giọng nói)
GROQ_API_KEY=gsk_your_groq_api_key_here

# 2. Bảo mật quản trị & CORS
ADMIN_API_KEY=change_this_to_a_strong_secret_key

# 3. ElevenLabs TTS (Tùy chọn — bỏ trống sẽ tự dùng Google TTS dự phòng)
# TTS_PROVIDER: auto (ưu tiên ElevenLabs nếu có key) | elevenlabs | google
TTS_PROVIDER=auto
ELEVENLABS_API_KEY=sk_your_elevenlabs_api_key_here

# Model khuyến nghị:
# - eleven_flash_v2_5       : Nhanh nhất (~75ms, hỗ trợ 32 ngôn ngữ gồm VI/EN/FR/JA/KO/ZH, rẻ 0.5 credit/ký tự)
# - eleven_multilingual_v2  : Giàu cảm xúc nhất (nhưng chậm hơn ~400-800ms và tốn 1 credit/ký tự)
ELEVENLABS_MODEL_ID=eleven_flash_v2_5

# Voice ID mặc định + Voice ID riêng từng ngôn ngữ (tùy chọn — bỏ trống sẽ dùng ELEVENLABS_VOICE_ID)
ELEVENLABS_VOICE_ID=EXAVITQu4vr4xnSDxMaL
ELEVENLABS_VOICE_VI=
ELEVENLABS_VOICE_EN=
ELEVENLABS_VOICE_FR=
ELEVENLABS_VOICE_JA=
ELEVENLABS_VOICE_KO=
ELEVENLABS_VOICE_ZH=

# Tinh chỉnh chất giọng bảo tàng (tùy chọn)
ELEVENLABS_STABILITY=0.52
ELEVENLABS_SIMILARITY=0.78
ELEVENLABS_STYLE=0.15
ELEVENLABS_SPEED=1.0
