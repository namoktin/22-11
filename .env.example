# ==============================================================================
# 🏛️ SMART MUSEUM AI VOICE SERVER — ENVIRONMENT CONFIG TEMPLATE (.env.example)
# ==============================================================================

# 1. Groq LLM & Whisper STT (Bắt buộc cho AI RAG & Nhận diện giọng nói)
GROQ_API_KEY=gsk_your_groq_api_key_here

# 2. Bảo mật quản trị & CORS
ADMIN_API_KEY=change_this_to_a_strong_secret_key

# 3. ElevenLabs TTS (Tùy chọn — bỏ trống sẽ tự dùng Google TTS dự phòng)
# TTS_PROVIDER: auto (ưu tiên ElevenLabs nếu có key) | elevenlabs | google
TTS_PROVIDER=auto
ELEVENLABS_API_KEY=sk_your_elevenlabs_api_key_here

# Model khuyến nghị cho tiếng Việt (70+ ngôn ngữ, hỗ trợ chuẩn 6 thanh điệu + language_code="vi"):
# - eleven_v3               : CHUẨN CHÍNH TẢ & THANH ĐIỆU TIẾNG VIỆT NHẤT (Hỏa Lò, kiết lỵ, lở loét, quản bút... 100% tròn chữ!)
# - eleven_v3_conversational: Bản hội thoại nhanh hơn ~30% của eleven_v3, giữ thanh điệu tốt
# - eleven_flash_v2_5       : Siêu nhanh (~250ms, 0.5 credit) nhưng dễ rớt dấu hỏi/ngã tiếng Việt
# (KHÔNG dùng eleven_multilingual_v2 vì model đó KHÔNG hỗ trợ tiếng Việt!)
ELEVENLABS_MODEL_ID=eleven_v3

# Voice ID mặc định + Voice ID riêng từng ngôn ngữ (tùy chọn — bỏ trống sẽ dùng ELEVENLABS_VOICE_ID)
ELEVENLABS_VOICE_ID=ArosID24mP18TEiQpNhs
ELEVENLABS_VOICE_VI=
ELEVENLABS_VOICE_EN=
ELEVENLABS_VOICE_FR=
ELEVENLABS_VOICE_JA=
ELEVENLABS_VOICE_KO=
ELEVENLABS_VOICE_ZH=

# Tinh chỉnh chất giọng bảo tàng:
# - Với eleven_v3: stability hợp lệ là 0.0 (Creative) | 0.5 (Natural - khuyên dùng) | 1.0 (Robust), speed: 1.05 trên trung bình một chút
ELEVENLABS_STABILITY=0.5
ELEVENLABS_SIMILARITY=0.80
ELEVENLABS_STYLE=0.0
ELEVENLABS_SPEED=1.05
ELEVENLABS_LATENCY_OPT=0
