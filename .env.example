# ==============================================================================
# 🏛️ SMART MUSEUM AI VOICE SERVER — ENVIRONMENT CONFIG TEMPLATE (.env.example)
# ==============================================================================

# 1. Groq LLM & Whisper STT (Bắt buộc cho AI RAG & Nhận diện giọng nói)
GROQ_API_KEY=gsk_your_groq_api_key_here

# 2. Bảo mật quản trị & CORS
ADMIN_API_KEY=change_this_to_a_strong_secret_key

# 3. ElevenLabs TTS (Tùy chọn — bỏ trống sẽ tự dùng Google TTS dự phòng)
# TTS_PROVIDER: auto (ưu tiên ElevenLabs nếu có key) | elevenlabs | google
TTS_PROVIDER=auto
ELEVENLABS_API_KEY=sk_your_elevenlabs_api_key_here

# Model khuyến nghị (CHÍNH THỨC hỗ trợ tiếng Việt 32 ngôn ngữ + language_code="vi"):
# - eleven_flash_v2_5       : Nhanh nhất (~75-300ms, hỗ trợ đầy đủ VI/EN/FR/JA/KO/ZH, rẻ 0.5 credit/ký tự)
# - eleven_turbo_v2_5       : Hỗ trợ tiếng Việt (0.5 credit/ký tự, chậm hơn flash một chút)
# (KHÔNG dùng eleven_multilingual_v2 cho tiếng Việt vì model đó không hỗ trợ tiếng Việt!)
ELEVENLABS_MODEL_ID=eleven_flash_v2_5

# Voice ID mặc định + Voice ID riêng từng ngôn ngữ (tùy chọn — bỏ trống sẽ dùng ELEVENLABS_VOICE_ID)
ELEVENLABS_VOICE_ID=ArosID24mP18TEiQpNhs
ELEVENLABS_VOICE_VI=
ELEVENLABS_VOICE_EN=
ELEVENLABS_VOICE_FR=
ELEVENLABS_VOICE_JA=
ELEVENLABS_VOICE_KO=
ELEVENLABS_VOICE_ZH=

# Tinh chỉnh chất giọng bảo tàng rõ thanh điệu tiếng Việt (speed: 1.05 trên trung bình một chút; latency_opt: 0 chuẩn phòng thu!)
ELEVENLABS_STABILITY=0.70
ELEVENLABS_SIMILARITY=0.80
ELEVENLABS_STYLE=0.0
ELEVENLABS_SPEED=1.05
ELEVENLABS_LATENCY_OPT=0
